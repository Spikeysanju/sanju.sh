---
import { BaseHead } from "@components/seo";
import {
	AUTHOR_EMAIL,
	AUTHOR_IMAGE,
	AUTHOR_PHONE,
	socialLinks,
} from "@data/index";
import RootLayout from "@layouts/root-layout.astro";

const url = (label: string) =>
	socialLinks.find((link) => link.label === label)?.url ?? "/";

const mailto = `mailto:${AUTHOR_EMAIL}?subject=${encodeURIComponent(
	"hi sanju, we just met",
)}`;

const whatsapp = `https://wa.me/${AUTHOR_PHONE.replace(
	/\D/g,
	"",
)}?text=${encodeURIComponent("hi sanju, we just met!")}`;

// brand marks from simple-icons (fill), ui icons from lucide (stroke)
const icons = {
	whatsapp:
		"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z",
	linkedin:
		"M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
	x: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
	github:
		"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
};

const tile =
	"flex flex-col justify-between p-4 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] transition-transform active:scale-[0.97] hover:bg-[var(--color-bg-muted)]";
const tileLabel = "font-medium text-base leading-tight";
const tileMeta = "text-sm text-[var(--color-text-secondary)] leading-tight";
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead
			title='sanju sivalingam, contact'
			description='message sanju sivalingam on whatsapp, save the contact, or connect on linkedin.'
			noindex={true}
		/>
	</head>

	<RootLayout>
		<main class='flex flex-col w-full max-w-sm gap-8 pt-6 lowercase'>
			<div class='flex flex-col items-center gap-4 text-center'>
				<img
					src={AUTHOR_IMAGE}
					alt='sanju sivalingam'
					width='96'
					height='96'
					fetchpriority='high'
					class='w-24 h-24 rounded-full object-cover outline outline-1 -outline-offset-1 outline-black/10 dark:outline-white/10'
				/>
				<div class='flex flex-col gap-1'>
					<h1
						class='text-[min(10vw,40px)] font-medium leading-[0.95] tracking-[-1.5px]'>
						sanju sivalingam
					</h1>
					<p class='type-body text-[var(--color-text-secondary)]'>
						designer, founder at thisux
					</p>
				</div>
			</div>

			<div class='grid grid-cols-6 auto-rows-[88px] gap-3'>
				<!-- primary: whatsapp, full width -->
				<a
					href={whatsapp}
					target='_blank'
					rel='noopener noreferrer'
					class='col-span-6 flex items-center justify-center gap-3 rounded-2xl bg-[#25d366] text-white font-medium text-lg transition-transform active:scale-[0.97] hover:bg-[#1ebe5a]'>
					<svg aria-hidden='true' viewBox='0 0 24 24' class='w-7 h-7 shrink-0' fill='currentColor'>
						<path d={icons.whatsapp} />
					</svg>
					message me on whatsapp
				</a>

				<!-- linkedin, tall -->
				<a
					href={url('linkedin')}
					target='_blank'
					rel='me noopener noreferrer'
					class={`${tile} col-span-3 row-span-2`}>
					<svg aria-hidden='true' viewBox='0 0 24 24' class='w-9 h-9 text-[#0a66c2]' fill='currentColor'>
						<path d={icons.linkedin} />
					</svg>
					<span class='flex flex-col gap-1'>
						<span class={tileLabel}>connect on linkedin</span>
						<span class={tileMeta}>/in/imsanju</span>
					</span>
				</a>

				<!-- save contact -->
				<a
					href='/sanju.vcf'
					class={`${tile} col-span-3`}>
					<svg aria-hidden='true' viewBox='0 0 24 24' class='w-6 h-6' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
						<path d='M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2' />
						<circle cx='9' cy='7' r='4' />
						<path d='M19 8v6' />
						<path d='M22 11h-6' />
					</svg>
					<span class={tileLabel}>save contact</span>
				</a>

				<!-- email -->
				<a href={mailto} class={`${tile} col-span-3`}>
					<svg aria-hidden='true' viewBox='0 0 24 24' class='w-6 h-6' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
						<rect width='20' height='16' x='2' y='4' rx='2' />
						<path d='m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7' />
					</svg>
					<span class={tileLabel}>email</span>
				</a>

				<!-- book a call, wide -->
				<a
					href='https://cal.com/imsanju/15min'
					target='_blank'
					rel='noopener noreferrer'
					class='col-span-6 flex flex-row items-center gap-4 p-4 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] transition-transform active:scale-[0.97] hover:bg-[var(--color-bg-muted)]'>
					<svg aria-hidden='true' viewBox='0 0 24 24' class='w-6 h-6 shrink-0' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
						<path d='M8 2v4' />
						<path d='M16 2v4' />
						<rect width='18' height='18' x='3' y='4' rx='2' />
						<path d='M3 10h18' />
					</svg>
					<span class='flex flex-col gap-1 mr-auto'>
						<span class={tileLabel}>book a call</span>
						<span class={tileMeta}>15 min, pick any slot</span>
					</span>
					<span aria-hidden='true' class='text-lg text-[var(--color-text-secondary)]'>→</span>
				</a>

				<!-- small tiles -->
				<a href={url('@x')} target='_blank' rel='me noopener noreferrer' class={`${tile} col-span-2`}>
					<svg aria-hidden='true' viewBox='0 0 24 24' class='w-5 h-5' fill='currentColor'>
						<path d={icons.x} />
					</svg>
					<span class={tileLabel}>x</span>
				</a>
				<a href={url('github')} target='_blank' rel='me noopener noreferrer' class={`${tile} col-span-2`}>
					<svg aria-hidden='true' viewBox='0 0 24 24' class='w-5 h-5' fill='currentColor'>
						<path d={icons.github} />
					</svg>
					<span class={tileLabel}>github</span>
				</a>
				<a href='/' class={`${tile} col-span-2`}>
					<svg aria-hidden='true' viewBox='0 0 24 24' class='w-5 h-5' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
						<circle cx='12' cy='12' r='10' />
						<path d='M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20' />
						<path d='M2 12h20' />
					</svg>
					<span class={tileLabel}>sanju.sh</span>
				</a>
			</div>
		</main>
	</RootLayout>
</html>
