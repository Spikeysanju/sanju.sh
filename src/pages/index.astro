---
import { ProductDock } from "@components/interactive";
import { Header } from "@components/misc";
import { BaseHead } from "@components/seo";
import { SITE_DESCRIPTION, socialLinks } from "@data/index";
import RootLayout from "@layouts/root-layout.astro";
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead
			title="sanju — designer, founder"
			description={SITE_DESCRIPTION}
			image='/images/ogimage.png'
		/>
	</head>

	<RootLayout>
		<div
			id='navbar+title'
			class='flex flex-col w-full gap-6 max-w-xl lowercase'>
			<Header />
			<h1
				class='w-full text-start text-[min(12vw,72px)] font-medium leading-[0.9] tracking-[-2px] sm:tracking-[-4px]'>
				sanju
				<span class='block text-[var(--color-text-secondary)]'
					>designer, founder</span
				>
			</h1>

			<div
				id='about'
				class='flex flex-col gap-4'>
				<div class='type-body'>
					I run <a
						href='https://thisux.com'
						target='_blank'
						rel='noopener noreferrer'
						class='underline underline-offset-2'
						>ThisUX</a
					>, a design-led product studio. We make things that work. For years, I
					wore many hats. Now I’m doing my own thing.
				</div>

				<div class='type-body min-w-0'>
					I work on ideas like
					<ProductDock />
				</div>

				<div class='type-body'>
					I team up with founders and business owners. We build MVPs, full
					products, or fix broken experiences. Design to code, we do it all.
				</div>

				<div class='type-body'>
					Want to chat?{" "}
					<a
						href='https://cal.com/imsanju/15min'
						target='_blank'
						rel='noopener noreferrer'
						class='underline underline-offset-2'>
						schedule a call
					</a>
				</div>
			</div>

			<div
				id='social-links'
				class='flex flex-row gap-4'>
				{
					socialLinks.map((link) => (
						<a
							href={link.url}
							rel={link.me ? 'me noopener noreferrer' : undefined}
							target={link.url.startsWith('mailto:') ? undefined : '_blank'}
							class='type-body text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:underline'>
							{link.label}
						</a>
					))
				}
			</div>
		</div>
	</RootLayout>
</html>
