---
import { ProductDock } from "@components/interactive";
import { Header } from "@components/misc";
import { BaseHead } from "@components/seo";
import { SITE_DESCRIPTION, socialLinks } from "@data/index";
import RootLayout from "@layouts/root-layout.astro";
import { layout, link, type } from "@styles/recipes";
import { sx } from "@utils/sx";
import { styles } from "./index.styles";
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead
			title="sanju — designer, founder"
			description={SITE_DESCRIPTION}
			image='/images/ogimage.png'
		/>
	</head>

	<RootLayout>
		<div
			id='navbar+title'
			{...sx(layout.page)}>
			<Header />
			<h1 {...sx(styles.title)}>
				sanju
				<span {...sx(styles.titleMeta)}>designer, founder</span>
			</h1>

			<div
				id='about'
				{...sx(styles.about)}>
				<div {...sx(type.body)}>
					I run <a
						href='https://thisux.com'
						target='_blank'
						rel='noopener noreferrer'
						{...sx(link.underline)}
						>ThisUX</a
					>, a design-led product studio. We make things that work. For years, I
					wore many hats. Now I’m doing my own thing.
				</div>

				<div {...sx(type.body, styles.minW0)}>
					I work on ideas like
					<ProductDock />
				</div>

				<div {...sx(type.body)}>
					I team up with founders and business owners. We build MVPs, full
					products, or fix broken experiences. Design to code, we do it all.
				</div>

				<div {...sx(type.body)}>
					Want to chat?{" "}
					<a
						href='https://cal.com/imsanju/15min'
						target='_blank'
						rel='noopener noreferrer'
						{...sx(link.underline)}>
						schedule a call
					</a>
				</div>
			</div>

			<div
				id='social-links'
				{...sx(styles.social)}>
				{
					socialLinks.map((social) => (
						<a
							href={social.url}
							rel={social.me ? 'me noopener noreferrer' : undefined}
							target={social.url.startsWith('mailto:') ? undefined : '_blank'}
							{...sx(type.body, link.muted)}>
							{social.label}
						</a>
					))
				}
			</div>
		</div>
	</RootLayout>
</html>
