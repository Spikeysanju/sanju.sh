---
import { getCollection } from "astro:content";
import { WritingItem } from "@components/cards";
import { Header } from "@components/misc";
import { BaseHead } from "@components/seo";
import RootLayout from "@layouts/root-layout.astro";

const writings = (await getCollection("writing")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead
			title="writings"
			description="essays by sanju sivalingam on product, design, engineering, and building software that works."
		/>
	</head>
	<RootLayout>
		<div
			id='Header+title'
			class='flex flex-col w-full gap-6 max-w-xl'>
			<Header />
			<h1 class='w-full type-page-title'>writings</h1>

			<div class='writings-list flex flex-col gap-6'>
				{
					writings.map((writing) => (
						<WritingItem
							title={writing.data.title}
							date={writing.data.pubDate}
							slug={writing.id}
						/>
					))
				}
			</div>
		</div>
	</RootLayout>

	<style>
		.writings-list:hover :global(.writing-item) {
			opacity: 0.45;
		}

		.writings-list :global(.writing-item:hover),
		.writings-list :global(.writing-item:focus-visible) {
			opacity: 1;
		}
	</style>
</html>
