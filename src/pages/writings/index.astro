---
import { getCollection } from "astro:content";
import { WritingItem } from "@components/cards";
import { Header } from "@components/misc";
import { BaseHead } from "@components/seo";
import RootLayout from "@layouts/root-layout.astro";
import { layout, type } from "@styles/recipes";
import { sx } from "@utils/sx";

const writings = (await getCollection("writing")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead
			title="writings"
			description="essays by sanju sivalingam on product, design, engineering, and building software that works."
		/>
	</head>
	<RootLayout>
		<div
			id='Header+title'
			{...sx(layout.page)}>
			<Header />
			<h1 {...sx(type.pageTitle)}>writings</h1>

			{
				writings.map((writing) => (
					<WritingItem
						title={writing.data.title}
						date={writing.data.pubDate}
						slug={writing.id}
					/>
				))
			}
		</div>
	</RootLayout>
</html>
