---
import { getCollection } from "astro:content";
import { ThoughtsItem } from "@components/cards";
import { Header } from "@components/misc";
import { BaseHead } from "@components/seo";
import RootLayout from "@layouts/root-layout.astro";
import { layout, type } from "@styles/recipes";
import { sx } from "@utils/sx";
import { styles } from "./index.styles";

const thoughts = (await getCollection("thought")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead
			title="thoughts"
			description="short notes from sanju sivalingam on ai, design, product, tools, and building."
		/>
	</head>
	<RootLayout>
		<div
			id='navbar+title'
			{...sx(layout.page)}>
			<Header />
			<h1 {...sx(type.pageTitle, styles.title)}>thoughts</h1>

			{
				thoughts.map((thought, i) => (
					<ThoughtsItem
						category={thought.data.category}
						content={thought.data.description}
						pubDate={thought.data.pubDate}
						slug={thought.id}
						index={i}
					/>
				))
			}
		</div>
	</RootLayout>
</html>
