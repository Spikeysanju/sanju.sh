---
import { Header } from "@components/misc";
import { BaseHead } from "@components/seo";
import { AUTHOR_IMAGE, AUTHOR_NAME, socialLinks } from "@data/index";
import RootLayout from "@layouts/root-layout.astro";
import { link, type } from "@styles/recipes";
import { absoluteUrl, profilePageJsonLd } from "@utils/seo";
import { sx } from "@utils/sx";
import { styles } from "./index.styles";

const pageUrl = absoluteUrl("/me");
const pageTitle = "about sanju sivalingam";
const pageDescription =
	"sanju sivalingam — designer, founder of thisux, and builder of products that work.";
const jsonLd = profilePageJsonLd({
	url: pageUrl,
	name: `${AUTHOR_NAME} — about`,
	description: pageDescription,
	imageOrigin: Astro.url,
});
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead
			title={pageTitle}
			description={pageDescription}
			jsonLd={jsonLd}
		/>
	</head>

	<RootLayout>
		<div
			id='og-page'
			{...sx(styles.page)}>
			<Header />

			<div
				id='hero'
				{...sx(styles.section)}>
				<div {...sx(styles.heroRow)}>
					<div class='headshot-wrap'>
						<img
							id='headshot-image'
							src={AUTHOR_IMAGE}
							alt='Sanju Sivalingam headshot'
							width='160'
							height='160'
							fetchpriority='high'
							decoding='async'
							{...sx(styles.headshot)}
						/>
						<button
							id='download-headshot'
							{...sx(styles.download)}>
							<span {...sx(styles.downloadLabel)}>
								download
							</span>
						</button>
					</div>
					<div {...sx(styles.heroCopy)}>
						<h1 {...sx(styles.name)}>
							sanju sivalingam
						</h1>
						<p {...sx(type.lede, styles.role)}>
							designer · founder
						</p>
					</div>
				</div>
			</div>

			<div
				id='bio'
				{...sx(styles.section)}>
				<h2 {...sx(type.section)}>
					bio
				</h2>
				<div {...sx(styles.copy)}>
					<p {...sx(type.body)}>
						Sanju Sivalingam is a designer and founder who runs <a
							href='https://thisux.com'
							target='_blank'
							rel='noopener noreferrer'
							{...sx(link.underline)}
							>ThisUX</a
						>, a design-led product studio. He builds products that actually work and helps other founders turn their ideas into reality. He's also big on open source and loves sharing what he learns along the way.
					</p>
				</div>
			</div>

			<div
				id='extended-bio'
				{...sx(styles.section)}>
				<h2 {...sx(type.section)}>
					extended bio
				</h2>
				<div {...sx(styles.copy)}>
					<p {...sx(type.body)}>
						Sanju Sivalingam is the founder of ThisUX, a design-led product studio that helps startups and businesses build products that actually work. He's been in the game for a while, wearing many hats along the way, and now he's focused on building his own thing.
					</p>
					<p {...sx(type.body)}>
						He works with founders and business owners to build everything from MVPs to full products, or sometimes just fixes what's broken. The approach is simple: design to code, he handles it all. The secret? Creating systems that work, no matter what technology or problem you're dealing with.
					</p>
					<p {...sx(type.body)}>
						When he's not building products, he's contributing to <a
							href='https://github.com/spikeysanju'
							target='_blank'
							rel='me noopener noreferrer'
							{...sx(link.underline)}
							>open source projects</a
						> and speaking at conferences. He believes in sharing knowledge and helping others learn from his experiences.
					</p>
					<p {...sx(type.body)}>
						He's currently working on several projects including <a
							href='https://dunsuite.com'
							target='_blank'
							rel='noopener noreferrer'
							{...sx(link.underline)}
							>Dun</a
						>, <a
							href='https://fli.so'
							target='_blank'
							rel='noopener noreferrer'
							{...sx(link.underline)}
							>Fli</a
						>, <a
							href='https://uiino.com'
							target='_blank'
							rel='noopener noreferrer'
							{...sx(link.underline)}
							>Uiino</a
						>, <a
							href='https://sticai.com'
							target='_blank'
							rel='noopener noreferrer'
							{...sx(link.underline)}
							>SticAI</a
						>, <a
							href='https://abogrow.com'
							target='_blank'
							rel='noopener noreferrer'
							{...sx(link.underline)}
							>aboGrow</a
						>, <a
							href='https://ffmpeg.info'
							target='_blank'
							rel='noopener noreferrer'
							{...sx(link.underline)}
							>ffmpeg info</a
						>, <a
							href='https://glance.sticai.com'
							target='_blank'
							rel='noopener noreferrer'
							{...sx(link.underline)}
							>Glance</a
						>, and <a
							href='https://spotlight.thisux.com'
							target='_blank'
							rel='noopener noreferrer'
							{...sx(link.underline)}
							>Spotlight</a
						>. He's always tinkering with new ideas and building things.
					</p>
				</div>
			</div>

			<div
				id='contact'
				{...sx(styles.section)}>
				<h2 {...sx(type.section)}>
					contact
				</h2>
				<p {...sx(type.body)}>
					Want to chat?
					<a
						href='https://cal.com/imsanju/15min'
						target='_blank'
						rel='noopener noreferrer'
						{...sx(link.underline)}>
						schedule a call
					</a>
					or
					<a
						href='mailto:work@sanju.sh?subject=Let%27s%20Collaborate&body=Hi%20Sanju,%0D%0A%0D%0AI%20would%20like%20to%20discuss%20a%20potential%20collaboration%20with%20you.%0D%0A%0D%0ABest%20regards,%0D%0A%5BYour%20Name%5D'
						{...sx(link.underline)}>
						drop me a line
					</a>
				</p>
			</div>

			<div
				id='social-links'
				{...sx(styles.social)}>
				<h2 {...sx(type.section)}>
					find me
				</h2>
				<div {...sx(styles.socialRow)}>
					{
						socialLinks.map((social) => (
							<a
								href={social.url}
								rel={social.me ? 'me noopener noreferrer' : undefined}
								target={social.url.startsWith('mailto:') ? undefined : '_blank'}
								{...sx(type.body, link.muted)}>
								{social.label}
							</a>
						))
					}
				</div>
			</div>
		</div>
	</RootLayout>

	<style>
		.headshot-wrap {
			position: relative;
		}

		.headshot-wrap:hover img {
			opacity: 0.75;
		}

		.headshot-wrap:hover button {
			opacity: 1;
		}
	</style>

	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const downloadButton = document.getElementById('download-headshot');
			const headshotImage = document.getElementById('headshot-image');

			if (downloadButton && headshotImage && headshotImage instanceof HTMLImageElement) {
				downloadButton.addEventListener('click', async (e) => {
					e.preventDefault();
					e.stopPropagation();

					try {
						const imageUrl = headshotImage.src;
						const response = await fetch(imageUrl);
						const blob = await response.blob();
						const url = window.URL.createObjectURL(blob);
						const a = document.createElement('a');
						a.href = url;
						a.download = 'sanju-sivalingam-headshot.png';
						document.body.appendChild(a);
						a.click();
						document.body.removeChild(a);
						window.URL.revokeObjectURL(url);
					} catch (error) {
						console.error('Error downloading image:', error);
						window.open(headshotImage.src, '_blank');
					}
				});
			}
		});
	</script>
</html>
