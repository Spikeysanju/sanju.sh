---
import { Header } from "@components/misc";
import { BaseHead } from "@components/seo";
import RootLayout from "@layouts/root-layout.astro";
import { layout, link, type } from "@styles/recipes";
import { sx } from "@utils/sx";
import { styles } from "./404.styles";

Astro.response.status = 404;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="page not found"
			description="this page doesn't exist. head home, or browse writings and thoughts."
			noindex={true}
		/>
	</head>

	<RootLayout>
		<div {...sx(layout.page)}>
			<Header />
			<div {...sx(styles.copy)}>
				<p {...sx(type.meta, type.uppercase)}>404</p>
				<h1 {...sx(type.pageTitle)}>page not found</h1>
				<p {...sx(type.lede)}>
					this url doesn't match anything on the site. it may have moved, or it never existed.
				</p>
			</div>
			<nav aria-label="helpful links" {...sx(styles.nav)}>
				<a href="/" {...sx(type.body, link.underline)}>go home</a>
				<a href="/writings" {...sx(type.body, link.underline)}>read writings</a>
				<a href="/thoughts" {...sx(type.body, link.underline)}>browse thoughts</a>
			</nav>
		</div>
	</RootLayout>
</html>
