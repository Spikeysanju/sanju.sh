---
import FormattedDate from "@components/misc/formatted-date.astro";
import { getCategoryStyle } from "@utils/index";
import { sx } from "@utils/sx";
import { styles } from "./thoughts-item.styles";

const { category, content, pubDate, index, slug } = Astro.props;
---

<a href={`/${slug}`}>
	<article
		id={category}
		{...sx(
			styles.card,
			getCategoryStyle(category),
			index % 2 === 0 ? styles.tiltEven : styles.tiltOdd,
		)}>
		<span {...sx(styles.quote)}>"</span>
		<h5 {...sx(styles.kicker)}>
			Sanju on{" "}
			<span {...sx(styles.wavy)}>{category}</span>
		</h5>
		<h1 {...sx(styles.content)}>
			{content}
		</h1>
		<p {...sx(styles.date)}>
			<FormattedDate date={pubDate} />
		</p>
	</article>
</a>
