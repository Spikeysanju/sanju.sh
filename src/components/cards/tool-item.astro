---
import { sx } from "@utils/sx";
import { styles } from "./tool-item.styles";

const { name, description, slug } = Astro.props;
---

<a href={`/tools/${slug}`}>
	<article {...sx(styles.card)}>
		<h3 {...sx(styles.name)}>{name}</h3>
		<p {...sx(styles.description)}>
			{description}
		</p>
	</article>
</a>
