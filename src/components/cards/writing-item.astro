---
import FormattedDate from "@components/misc/formatted-date.astro";
import { type } from "@styles/recipes";
import { sx } from "@utils/sx";
import { styles } from "./writing-item.styles";

const { title, date, slug } = Astro.props;
---

<a href={`/${slug}`}>
	<article {...sx(styles.row)}>
		<h3 {...sx(styles.title)}>{title}</h3>
		<p {...sx(type.meta, styles.date)}>
			<FormattedDate date={date} />
		</p>
	</article>
</a>
