---
import { type } from "@styles/recipes";
import { sx } from "@utils/sx";
import { styles } from "./related-posts.styles";

interface RelatedPost {
	title: string;
	description: string;
	slug: string;
	sectionLabel: string;
}

interface Props {
	posts: RelatedPost[];
	heading?: string;
}

const { posts, heading = "keep reading" } = Astro.props;
---

{
	posts.length > 0 && (
		<nav
			aria-label='related posts'
			{...sx(styles.nav)}>
			<p {...sx(styles.heading)}>{heading}</p>
			<ul {...sx(styles.list)}>
				{posts.map((post) => (
					<li>
						<a
							href={`/${post.slug}`}
							{...sx(styles.item)}>
							<span {...sx(styles.label)}>
								{post.sectionLabel}
							</span>
							<span {...sx(type.body, styles.title)}>
								{post.title}
							</span>
							<span {...sx(styles.description)}>
								{post.description}
							</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}
