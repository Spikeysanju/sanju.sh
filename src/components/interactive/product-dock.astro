---
import { products } from "@data/index";
---

<nav
	class='product-dock'
	aria-label='products'
	style={`--dock-count: ${products.length}`}>
	<ul class='product-dock__rail'>
		{
			products.map((product) => (
				<li class='product-dock__item'>
					<a
						href={product.url}
						target='_blank'
						rel='noopener noreferrer'
						class='product-dock__link'
						aria-label={product.name}>
						<span
							class='product-dock__tooltip'
							aria-hidden='true'>
							{product.name}
						</span>
						<img
							src={product.image}
							alt=''
							width='48'
							height='48'
							loading='lazy'
							decoding='async'
							class='product-dock__icon'
							draggable='false'
						/>
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.product-dock {
		--dock-icon: 2.85rem;
		--dock-gap: 0.35rem;
		--dock-pad-x: 0.5rem;
		--dock-pad-y: 0.45rem;
		--dock-tooltip-space: 2.25rem;

		display: block;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		margin-top: 0.5rem;
		overflow-x: clip;
		overflow-y: visible;
		padding-top: var(--dock-tooltip-space);
	}

	.product-dock__rail {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--dock-gap);
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: var(--dock-pad-y) var(--dock-pad-x);
		list-style: none;
		border-radius: 9999px;
		background: var(--ds-background-200);
		box-shadow: var(--ds-shadow-border);
	}

	.product-dock__item {
		position: relative;
		display: flex;
		flex: 1 1 0;
		align-items: flex-end;
		justify-content: center;
		min-width: 0;
		max-width: var(--dock-icon);
		aspect-ratio: 1;
		height: auto;
		transform-origin: 50% 100%;
		transition-property: width, max-width;
		transition-duration: 140ms;
		transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
	}

	.product-dock__link {
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		outline: none;
		transform-origin: 50% 100%;
		transition-property: transform;
		transition-duration: 140ms;
		transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
	}

	.product-dock__link:active {
		transform: scale(0.96);
	}

	.product-dock__icon {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 9999px;
		overflow: hidden;
		object-fit: cover;
		user-select: none;
		pointer-events: none;
		background: var(--ds-gray-100);
		outline: 1px solid oklch(0 0 0 / 0.1);
		outline-offset: -1px;
	}

	:global(.dark) .product-dock__icon {
		outline-color: oklch(1 0 0 / 0.1);
	}

	@keyframes product-dock-tooltip-in {
		from {
			opacity: 0;
			transform: translateX(-50%) translateY(0.25rem) scale(0.96);
		}

		to {
			opacity: 1;
			transform: translateX(-50%) translateY(0) scale(1);
		}
	}

	.product-dock__tooltip {
		position: absolute;
		bottom: calc(100% + 0.7rem);
		left: 50%;
		z-index: 5;
		padding: 0.28rem 0.55rem;
		border-radius: 0.5rem;
		background: var(--ds-background-100);
		color: var(--ds-gray-1000);
		font-size: var(--fs-xs);
		font-weight: var(--fw-medium);
		line-height: 1;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transform: translateX(-50%) translateY(0.25rem) scale(0.96);
		box-shadow: var(--ds-shadow-border);
	}

	.product-dock__link:hover .product-dock__tooltip,
	.product-dock__link:focus-visible .product-dock__tooltip {
		animation: product-dock-tooltip-in 160ms cubic-bezier(0.2, 0, 0, 1) forwards;
	}

	.product-dock__link:focus-visible .product-dock__icon {
		outline: 2px solid var(--ds-gray-1000);
		outline-offset: 3px;
	}

	@media (min-width: 640px) {
		.product-dock {
			width: fit-content;
			--dock-gap: 0.45rem;
			--dock-pad-x: 0.65rem;
			--dock-pad-y: 0.5rem;
		}

		.product-dock__item {
			flex: 0 0 var(--dock-icon);
			width: var(--dock-icon);
			height: var(--dock-icon);
			max-width: var(--dock-icon);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.product-dock__item,
		.product-dock__link {
			transition: none;
		}

		.product-dock__link:hover .product-dock__tooltip,
		.product-dock__link:focus-visible .product-dock__tooltip {
			animation: none;
			opacity: 1;
			transform: translateX(-50%) translateY(0) scale(1);
		}
	}
</style>

<script>
	function initProductDock(root: HTMLElement) {
		const items = Array.from(
			root.querySelectorAll<HTMLElement>(".product-dock__item"),
		);
		if (!items.length) return;

		const baseSize = 2.85; // rem
		const maxScale = 1.16;
		const influence = 52;

		const reset = () => {
			for (const item of items) {
				item.style.width = "";
				const link = item.querySelector<HTMLElement>(".product-dock__link");
				if (link) link.style.transform = "";
			}
		};

		const scaleAt = (distance: number) => {
			const t = Math.min(Math.abs(distance) / influence, 1);
			const eased = 1 - t * t * (3 - 2 * t);
			return 1 + (maxScale - 1) * eased;
		};

		const canMagnify = () =>
			window.matchMedia("(pointer: fine)").matches &&
			window.matchMedia("(min-width: 640px)").matches &&
			!window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		const onMove = (event: PointerEvent) => {
			if (!canMagnify()) {
				reset();
				return;
			}

			for (const item of items) {
				const rect = item.getBoundingClientRect();
				const center = rect.left + rect.width / 2;
				const scale = scaleAt(event.clientX - center);
				const link = item.querySelector<HTMLElement>(".product-dock__link");

				item.style.width = `${baseSize * scale}rem`;
				if (link) {
					link.style.transform = `translateY(${(1 - scale) * 6}px) scale(${scale})`;
				}
			}
		};

		root.addEventListener("pointermove", onMove);
		root.addEventListener("pointerleave", reset);
		root.addEventListener("pointercancel", reset);
	}

	const docks = document.querySelectorAll<HTMLElement>(".product-dock");
	for (const dock of docks) initProductDock(dock);
</script>
