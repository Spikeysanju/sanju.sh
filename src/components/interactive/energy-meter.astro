---
import { sx } from "@utils/sx";
import { styles } from "./energy-meter.styles";

const drains = [
	{ emoji: "💬", label: "Reply to every DM", drain: 25 },
	{ emoji: "📅", label: "Attend every meeting", drain: 20 },
	{ emoji: "🆓", label: "Give free advice", drain: 20 },
	{ emoji: "🔔", label: "Stay in every group chat", drain: 15 },
	{ emoji: "🤝", label: "Say yes to everything", drain: 20 },
];
---

<div class="energy-meter-wrapper" {...sx(styles.wrap)}>
	<div {...sx(styles.card)}>
		<div {...sx(styles.readout)}>
			<div class="energy-percent" {...sx(styles.percent)}>
				100%
			</div>
			<div class="energy-status" {...sx(styles.status)}>
				Fully charged
			</div>
		</div>

		<div {...sx(styles.batteryRow)}>
			<div class="battery-body" {...sx(styles.body)}>
				<div class="battery-fill" style="width: 100%"></div>
			</div>
			<div {...sx(styles.cap)}></div>
		</div>

		<div {...sx(styles.stage)}>
			{drains.map((item, index) => (
				<div
					class="drain-card"
					{...sx(styles.cardLayer)}
					data-index={index}
					data-drain={item.drain}
				>
					<div {...sx(styles.line)}>
						<span>{item.emoji}</span>
						<span>{item.label}</span>
					</div>
					<div {...sx(styles.drain)}>
						-{item.drain}%
					</div>
				</div>
			))}

			<div class="final-card" {...sx(styles.cardLayer)}>
				<div {...sx(styles.line, styles.center)}>
					Nothing left for the people who matter.
				</div>
			</div>

			<div class="initial-card is-on" {...sx(styles.cardLayer, styles.visible)}>
				<div {...sx(styles.whisper)}>
					Watch where your energy goes...
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.battery-body {
		transition: box-shadow 0.5s ease;
	}

	.battery-body.low {
		box-shadow: inset 0 0 12px color-mix(in oklab, var(--color-accent-writing) 40%, transparent);
	}

	.battery-body.critical {
		box-shadow: inset 0 0 16px color-mix(in oklab, var(--color-accent-thoughts) 50%, transparent);
		animation: pulse-glow 1.5s ease-in-out infinite;
	}

	@keyframes pulse-glow {
		0%, 100% {
			box-shadow: inset 0 0 16px color-mix(in oklab, var(--color-accent-thoughts) 50%, transparent);
		}
		50% {
			box-shadow: inset 0 0 24px color-mix(in oklab, var(--color-accent-thoughts) 70%, transparent);
		}
	}

	.battery-fill {
		position: absolute;
		top: 0;
		left: 0;
		bottom: 0;
		background: linear-gradient(90deg, var(--color-success), #22c55e);
		transition: width 0.7s ease-out, background 0.5s ease;
	}

	.battery-fill.medium {
		background: linear-gradient(90deg, var(--color-warning), #eab308);
	}

	.battery-fill.low {
		background: linear-gradient(90deg, #fb923c, var(--color-accent-writing));
	}

	.battery-fill.critical {
		background: linear-gradient(90deg, var(--color-danger), var(--color-accent-thoughts));
	}

	.energy-percent.critical {
		color: var(--color-accent-thoughts);
	}

	.drain-card,
	.final-card,
	.initial-card {
		opacity: 0;
		transition: opacity 0.5s ease;
	}

	.drain-card.is-on,
	.final-card.is-on,
	.initial-card.is-on {
		opacity: 1;
	}
</style>

<script>
	const wrapper = document.querySelector('.energy-meter-wrapper');
	const percentEl = wrapper?.querySelector('.energy-percent');
	const statusEl = wrapper?.querySelector('.energy-status');
	const batteryBody = wrapper?.querySelector('.battery-body') as HTMLElement;
	const batteryFill = wrapper?.querySelector('.battery-fill') as HTMLElement;
	const cards = wrapper?.querySelectorAll('.drain-card');
	const finalCard = wrapper?.querySelector('.final-card');
	const initialCard = wrapper?.querySelector('.initial-card');

	const drains = [25, 20, 20, 15, 20];
	const statuses = [
		{ threshold: 100, text: 'Fully charged' },
		{ threshold: 80, text: 'Still good' },
		{ threshold: 60, text: 'Getting tired' },
		{ threshold: 40, text: 'Running low' },
		{ threshold: 20, text: 'Nearly empty' },
		{ threshold: 1, text: 'Burnout incoming' },
		{ threshold: 0, text: 'Completely drained' },
	];

	let currentEnergy = 100;
	let currentIndex = -1;
	let isRunning = false;

	function getStatus(energy: number): string {
		for (const s of statuses) {
			if (energy >= s.threshold) return s.text;
		}
		return 'Completely drained';
	}

	function updateDisplay(energy: number) {
		if (percentEl) {
			percentEl.textContent = `${energy}%`;
			percentEl.classList.toggle('critical', energy <= 20);
		}

		if (statusEl) {
			statusEl.textContent = getStatus(energy);
		}

		if (batteryFill) {
			batteryFill.style.width = `${energy}%`;
			batteryFill.classList.remove('medium', 'low', 'critical');
			batteryBody?.classList.remove('low', 'critical');

			if (energy <= 20) {
				batteryFill.classList.add('critical');
				batteryBody?.classList.add('critical');
			} else if (energy <= 40) {
				batteryFill.classList.add('low');
				batteryBody?.classList.add('low');
			} else if (energy <= 60) {
				batteryFill.classList.add('medium');
			}
		}
	}

	function showCard(index: number) {
		initialCard?.classList.remove('is-on');
		cards?.forEach(card => card.classList.remove('is-on'));
		finalCard?.classList.remove('is-on');

		if (index === -1) {
			initialCard?.classList.add('is-on');
		} else if (index === drains.length) {
			finalCard?.classList.add('is-on');
		} else {
			cards?.[index]?.classList.add('is-on');
		}
	}

	function runSequence() {
		if (!isRunning) return;

		currentIndex++;

		if (currentIndex < drains.length) {
			currentEnergy = Math.max(0, currentEnergy - drains[currentIndex]);
			updateDisplay(currentEnergy);
			showCard(currentIndex);
			setTimeout(runSequence, 1500);
		} else if (currentIndex === drains.length) {
			showCard(currentIndex);
			setTimeout(runSequence, 2500);
		} else {
			currentEnergy = 100;
			currentIndex = -1;
			updateDisplay(100);
			showCard(-1);
			setTimeout(runSequence, 2000);
		}
	}

	function startAnimation() {
		if (isRunning) return;
		isRunning = true;
		setTimeout(runSequence, 1500);
	}

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					startAnimation();
				}
			});
		},
		{ threshold: 0.5 }
	);

	if (wrapper) {
		observer.observe(wrapper);
	}
</script>
