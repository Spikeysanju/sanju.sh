---
import { widget } from "@styles/recipes/widget";
import { sx } from "@utils/sx";
import { styles } from "./commit-compare.styles";
---

<div {...sx(widget.wrap)}>
	<div {...sx(widget.grid)}>
		<div {...sx(widget.surface)}>
			<div {...sx(styles.chrome)}>
				<div {...sx(widget.traffic)}>
					<div {...sx(widget.dot, widget.dotRed)}></div>
					<div {...sx(widget.dot, widget.dotYellow)}></div>
					<div {...sx(widget.dot, widget.dotGreen)}></div>
				</div>
				<span {...sx(widget.meta)}>commit message</span>
			</div>
			<div {...sx(styles.body)}>
				<div {...sx(styles.author)}>
					<img src="/images/sanju.png" alt="sanju" width="24" height="24" loading="lazy" decoding="async" {...sx(styles.avatar)} />
					<span {...sx(widget.meta)}>sanju committed 3 hours ago</span>
				</div>
				<div {...sx(styles.message)}>
					Fixed bug
				</div>
				<div {...sx(styles.stats)}>
					<span {...sx(widget.dotRow)}>
						<svg {...sx(styles.icon)} fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
						</svg>
						1 file changed
					</span>
					<span {...sx(styles.add)}>+2</span>
					<span {...sx(styles.del)}>-1</span>
				</div>
			</div>
			<div {...sx(styles.footer)}>
				<p {...sx(styles.footerNote)}>6 months later: "Why did we change this?"</p>
				<p {...sx(styles.footerWarn)}>Good luck figuring that out.</p>
			</div>
		</div>

		<div {...sx(widget.terminal)}>
			<div {...sx(styles.chromeDark)}>
				<div {...sx(widget.traffic)}>
					<div {...sx(widget.dot, widget.dotRed)}></div>
					<div {...sx(widget.dot, widget.dotYellow)}></div>
					<div {...sx(widget.dot, widget.dotGreen)}></div>
				</div>
				<span {...sx(widget.metaOnDark)}>commit message</span>
			</div>
			<div {...sx(styles.body)}>
				<div {...sx(styles.author)}>
					<img src="/images/sanju.png" alt="sanju" width="24" height="24" loading="lazy" decoding="async" {...sx(styles.avatar)} />
					<span {...sx(widget.metaOnDark)}>sanju committed 3 hours ago</span>
				</div>
				<div {...sx(styles.messageDark)}>
					<p {...sx(styles.goodTitle)}>fix(auth): increase session timeout to 60min</p>
					<p {...sx(styles.goodBody)}>
						Users on slow connections were getting dropped at 30min.
						<br />Support tickets up 23% this month from timeout issues.
						<br />
						<br />Discussed with security team - low risk given we
						<br />already have refresh token rotation.
						<br />
						<br />Closes #234
					</p>
				</div>
				<div {...sx(styles.stats)}>
					<span {...sx(widget.dotRow)}>
						<svg {...sx(styles.icon)} fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
						</svg>
						1 file changed
					</span>
					<span {...sx(styles.add)}>+2</span>
					<span {...sx(styles.del)}>-1</span>
				</div>
			</div>
			<div {...sx(styles.footerDark)}>
				<p {...sx(widget.metaOnDark)}>6 months later: "Why did we change this?"</p>
				<p {...sx(styles.footerOk)}>You already know.</p>
			</div>
		</div>
	</div>
</div>
