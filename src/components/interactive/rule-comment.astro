---

---

<div class="rule-comment-wrapper">
	<div class="rc-card">
		<div class="rc-toolbar">
			<div class="rc-status">
				<div class="rc-dot"></div>
				<span class="rc-label">agent</span>
			</div>
			<button
				id="rc-start"
				class="rc-btn"
				type="button"
			>
				play
			</button>
		</div>

		<p id="rc-task" class="rc-task is-on">
			i asked it to add a package. it ran npm.
		</p>

		<div class="rc-steps" id="rc-steps">
			<div class="rc-step is-on" data-step="1">
				<p class="rc-step-title">what it did</p>
				<p class="rc-result is-on rc-mono">npm install</p>
			</div>

			<div class="rc-step is-on" data-step="2">
				<p class="rc-step-title">the rule</p>
				<p class="rc-result is-on rc-mono">use bun.<br />never npm.</p>
			</div>

			<div class="rc-step is-on" data-step="3">
				<p class="rc-step-title">the why</p>
				<p class="rc-result is-on rc-mono"># 2026-09-02  it ran npm in a bun repo<br /># keep unless we leave bun</p>
				<p class="rc-note is-on">the agent only sees the rule. i keep the why so i can delete this later.</p>
			</div>
		</div>
	</div>
</div>

<style>
	.rule-comment-wrapper {
		margin-block: 2rem;
	}

	.rc-card {
		padding: 24px;
		overflow: hidden;
		border-radius: 12px;
		background: var(--ds-background-200);
		color: var(--ds-gray-1000);
		box-shadow: var(--ds-shadow-border);
		-webkit-font-smoothing: antialiased;
	}

	.rc-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 16px;
	}

	.rc-status {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.rc-dot {
		width: 8px;
		height: 8px;
		border-radius: 9999px;
		background: var(--ds-gray-600);
	}

	.rc-label {
		font-size: 12px;
		font-weight: 500;
		color: var(--ds-gray-900);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.rc-btn {
		position: relative;
		min-height: 40px;
		padding: 8px 14px;
		border: 0;
		border-radius: 9999px;
		background: var(--ds-gray-100);
		color: var(--ds-gray-1000);
		font-size: 12px;
		font-weight: 500;
		cursor: pointer;
		transition-property: transform, background-color;
		transition-duration: 150ms;
		transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
	}

	.rc-btn::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		width: 40px;
		height: 40px;
		transform: translate(-50%, -50%);
	}

	.rc-btn:hover {
		background: var(--ds-gray-200);
	}

	.rc-btn:active {
		transform: scale(0.96);
	}

	.rc-btn:disabled {
		opacity: 0.55;
		cursor: default;
	}

	.rc-task {
		margin: 0 0 16px;
		font-weight: 500;
		color: var(--ds-gray-1000);
		opacity: 0;
		transition-property: opacity;
		transition-duration: 200ms;
		transition-timing-function: ease-out;
	}

	.rc-task.is-on {
		opacity: 1;
	}

	.rc-steps {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.rc-step {
		opacity: 0;
		transform: translateX(-8px);
		transition-property: opacity, transform;
		transition-duration: 220ms;
		transition-timing-function: ease-out;
	}

	.rc-step.is-on {
		opacity: 1;
		transform: translateX(0);
	}

	.rc-step-title {
		margin: 0;
		font-size: 12px;
		font-weight: 500;
		color: var(--ds-gray-900);
	}

	.rc-result {
		display: none;
		margin: 6px 0 0;
		font-size: 14px;
		line-height: 1.5;
		color: var(--ds-gray-1000);
	}

	.rc-result.is-on {
		display: block;
	}

	.rc-mono {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}

	.rc-note {
		display: none;
		margin: 8px 0 0;
		font-size: 13px;
		line-height: 1.5;
		color: var(--ds-gray-900);
	}

	.rc-note.is-on {
		display: block;
	}

	@media (prefers-reduced-motion: reduce) {
		.rc-btn,
		.rc-task,
		.rc-step {
			transition: none;
		}
	}
</style>

<script>
	const startBtn = document.getElementById('rc-start');
	const taskEl = document.getElementById('rc-task');
	const steps = document.querySelectorAll('.rc-step');
	let isRunning = false;

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	async function sleep(ms: number) {
		if (reduced) return;
		await new Promise((resolve) => setTimeout(resolve, ms));
	}

	function showAll() {
		taskEl?.classList.add('is-on');
		steps.forEach((step) => {
			step.classList.add('is-on');
			step.querySelector('.rc-result')?.classList.add('is-on');
			step.querySelector('.rc-note')?.classList.add('is-on');
		});
	}

	function hideAll() {
		taskEl?.classList.remove('is-on');
		steps.forEach((step) => {
			step.classList.remove('is-on');
			step.querySelector('.rc-result')?.classList.remove('is-on');
			step.querySelector('.rc-note')?.classList.remove('is-on');
		});
	}

	async function runSimulation() {
		if (isRunning) return;
		isRunning = true;

		if (startBtn) {
			startBtn.textContent = 'playing...';
			(startBtn as HTMLButtonElement).disabled = true;
		}

		hideAll();
		await sleep(180);

		taskEl?.classList.add('is-on');
		await sleep(320);

		for (const step of steps) {
			step.classList.add('is-on');
			step.querySelector('.rc-result')?.classList.add('is-on');
			await sleep(280);
			step.querySelector('.rc-note')?.classList.add('is-on');
			await sleep(160);
		}

		if (startBtn) {
			startBtn.textContent = 'play again';
			(startBtn as HTMLButtonElement).disabled = false;
		}

		isRunning = false;
	}

	startBtn?.addEventListener('click', runSimulation);
	showAll();
</script>
