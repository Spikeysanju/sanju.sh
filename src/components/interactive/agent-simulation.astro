---
import { widget } from "@styles/recipes/widget";
import { sx } from "@utils/sx";
import { styles } from "./agent-simulation.styles";
---

<div {...sx(widget.wrap)}>
	<div {...sx(widget.terminal, styles.card)}>
		<div {...sx(styles.toolbar)}>
			<div {...sx(styles.status)}>
				<div class="live-dot" {...sx(styles.live)}></div>
				<span {...sx(styles.label)}>AI Agent</span>
			</div>
			<button
				id="agent-start"
				{...sx(styles.run)}
			>
				Run simulation
			</button>
		</div>

		<div id="agent-task" {...sx(styles.task)}>
			Processing discount request...
		</div>

		<div id="agent-steps" {...sx(styles.steps)}>
			{[
				["Checking customer history...", "Found: Enterprise account, 2 years, $48k ARR"],
				["Checking open tickets...", "Found: 3 critical tickets unresolved (14 days avg)"],
				["Searching precedent...", "Found: Similar deal Q3 got 20% exception (policy v2.1 §4)"],
				["Routing for approval...", "VP Sales approved (churn risk flag triggered)"],
				["Saving decision trace...", "Done. Full context logged automatically."],
			].map(([title, result], index) => (
				<div class="agent-step" data-step={index + 1} style="opacity: 0">
					<div {...sx(styles.stepRow)}>
						<div class:list={['step-icon', sx(styles.icon).class]} style={sx(styles.icon).style}>
							<svg class:list={['checkmark', 'hidden', sx(styles.mark).class]} style={sx(styles.mark).style} fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
							</svg>
							<div class="spinner hidden"></div>
						</div>
						<div {...sx(styles.copy)}>
							<p {...sx(styles.stepTitle)}>{title}</p>
							<p class:list={['step-result', 'hidden', sx(styles.result).class]} style={sx(styles.result).style}>{result}</p>
						</div>
					</div>
				</div>
			))}
		</div>

		<div id="agent-complete" class:list={['hidden', sx(styles.done).class]} style={sx(styles.done).style}>
			<p {...sx(styles.doneTitle)}>Decision trace captured with zero extra effort.</p>
			<p {...sx(styles.doneNote)}>The agent already had the context. It just saved it.</p>
		</div>
	</div>
</div>

<style>
	.live-dot {
		animation: pulse 2s ease-in-out infinite;
	}

	.spinner {
		width: 0.75rem;
		height: 0.75rem;
		border: 2px solid var(--color-on-terminal-muted);
		border-top-color: var(--color-success);
		border-radius: 9999px;
		animation: spin 0.7s linear infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.4; }
	}

	@keyframes spin {
		to { transform: rotate(360deg); }
	}
</style>

<script>
	const startBtn = document.getElementById('agent-start');
	const taskEl = document.getElementById('agent-task');
	const steps = document.querySelectorAll('.agent-step');
	const completeEl = document.getElementById('agent-complete');
	let isRunning = false;

	async function sleep(ms: number) {
		return new Promise(resolve => setTimeout(resolve, ms));
	}

	async function runStep(step: Element) {
		const spinner = step.querySelector('.spinner');
		const checkmark = step.querySelector('.checkmark');
		const result = step.querySelector('.step-result');
		const icon = step.querySelector('.step-icon');

		(step as HTMLElement).style.opacity = '1';
		(step as HTMLElement).style.transform = 'translateX(0)';

		spinner?.classList.remove('hidden');

		await sleep(800 + Math.random() * 400);

		spinner?.classList.add('hidden');
		checkmark?.classList.remove('hidden');
		(checkmark as HTMLElement).style.color = 'var(--color-success)';
		(icon as HTMLElement).style.background = 'color-mix(in oklab, var(--color-success) 12%, transparent)';

		result?.classList.remove('hidden');
		(result as HTMLElement).style.color = 'var(--color-on-terminal-muted)';

		await sleep(300);
	}

	async function runSimulation() {
		if (isRunning) return;
		isRunning = true;

		steps.forEach(step => {
			(step as HTMLElement).style.opacity = '0';
			(step as HTMLElement).style.transform = 'translateX(-10px)';
			const spinner = step.querySelector('.spinner');
			const checkmark = step.querySelector('.checkmark');
			const result = step.querySelector('.step-result');
			const icon = step.querySelector('.step-icon');
			spinner?.classList.add('hidden');
			checkmark?.classList.add('hidden');
			result?.classList.add('hidden');
			(checkmark as HTMLElement).style.color = '';
			(icon as HTMLElement).style.background = '';
		});
		completeEl?.classList.add('hidden');

		if (startBtn) {
			startBtn.textContent = 'Running...';
			(startBtn as HTMLButtonElement).disabled = true;
		}

		if (taskEl) {
			(taskEl as HTMLElement).style.opacity = '1';
		}

		await sleep(500);

		for (const step of steps) {
			await runStep(step);
		}

		await sleep(400);
		completeEl?.classList.remove('hidden');

		if (startBtn) {
			startBtn.textContent = 'Run again';
			(startBtn as HTMLButtonElement).disabled = false;
		}

		isRunning = false;
	}

	steps.forEach(step => {
		(step as HTMLElement).style.transition = 'opacity 0.3s ease, transform 0.3s ease';
		(step as HTMLElement).style.transform = 'translateX(-10px)';
	});

	startBtn?.addEventListener('click', runSimulation);
</script>
