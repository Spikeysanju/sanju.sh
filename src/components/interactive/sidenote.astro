---
import { sx } from "@utils/sx";
import { styles } from "./sidenote.styles";

interface Props {
	id: string;
}

const { id } = Astro.props;
---

<span class="sidenote-wrapper">
	<button
		class="sidenote-toggle"
		{...sx(styles.toggle)}
		aria-label={`toggle sidenote ${id}`}
		data-sidenote-id={id}
	>
		<sup {...sx(styles.sup)}>{id}</sup>
	</button>
	<span
		class="sidenote-body"
		{...sx(styles.body)}
		data-sidenote-body={id}
	>
		<span {...sx(styles.lead)}>{id}:</span>{" "}
		<slot />
	</span>
</span>

<style>
	@media (min-width: 1280px) {
		.sidenote-body {
			float: right;
			clear: right;
			width: 14rem;
			margin-right: -17rem;
			margin-bottom: 0.5rem;
		}
	}

	.sidenote-body.is-open {
		display: block;
		width: 100%;
		margin-top: 0.5rem;
		margin-bottom: 0.5rem;
		padding: 0.75rem;
		background: color-mix(in oklab, var(--color-bg-muted) 80%, transparent);
		border-radius: 0.5rem;
	}
</style>

<script>
	document.addEventListener("click", (e) => {
		const toggle = (e.target as HTMLElement).closest(".sidenote-toggle");
		if (!toggle || window.innerWidth >= 1280) return;

		const id = toggle.getAttribute("data-sidenote-id");
		const body = document.querySelector(`[data-sidenote-body="${id}"]`);
		if (body) {
			body.classList.toggle("is-open");
		}
	});
</script>
