---
import { ship } from "@styles/recipes";
import { sx } from "@utils/sx";
import { styles } from "./dots.styles";

const { ship_count } = Astro.props;

const tone =
	ship_count === 0
		? ship.empty
		: ship_count <= 2
			? ship.low
			: ship_count > 4
				? ship.high
				: ship.mid;
---

<div {...sx(styles.dot, tone)}></div>
