---
import { sx } from "@utils/sx";
import { styles } from "./follow-x.styles";

interface Props {
	xHandle: string;
	label: string;
}

const { xHandle, label }: Props = Astro.props;
---

<div {...sx(styles.card)}>
	<div {...sx(styles.copy)}>
		<h5 {...sx(styles.title)}>
			{label}
		</h5>

		<button
			id='button-follow-twitter'
			{...sx(styles.button)}
			onclick={`window.open('https://x.com/${xHandle}', '_blank')`}>
			@{xHandle}
		</button>
	</div>
</div>
