---
import type { CollectionEntry } from "astro:content";
import { RelatedPosts } from "@components/cards";
import { Header } from "@components/misc";
import FormattedDate from "@components/misc/formatted-date.astro";
import { BaseHead } from "@components/seo";
import RootLayout from "@layouts/root-layout.astro";
import { layout, type } from "@styles/recipes";
import type { BreadcrumbItem } from "@utils/seo";
import { sx } from "@utils/sx";
import { styles } from "./writing-layout.styles";

type Related = {
	title: string;
	description: string;
	slug: string;
	sectionLabel: string;
};

type Props = CollectionEntry<"thought">["data"] & {
	ogImage?: string;
	wordCount?: number;
	relatedPosts?: Related[];
	breadcrumbs?: BreadcrumbItem[];
};

const {
	title,
	description,
	showTldr,
	pubDate,
	updatedDate,
	readingTime,
	ogImage,
	wordCount,
	relatedPosts = [],
	breadcrumbs = [
		{ name: "home", url: "/" },
		{ name: "thoughts", url: "/thoughts" },
		{ name: title, url: Astro.url.pathname },
	],
} = Astro.props;
---

<html lang='en'>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={ogImage}
			type='article'
			publishedTime={pubDate}
			modifiedTime={updatedDate}
			breadcrumbs={breadcrumbs}
			wordCount={wordCount}
		/>
	</head>

	<RootLayout maxWidth='article'>
		<div
			id='navbar+title'
			{...sx(layout.articlePage)}>
			<Header />

			<article
				id='blog-content'
				{...sx(styles.article)}>
				<h1 {...sx(styles.measure, type.pageTitle)}>
					{title}
				</h1>
				<div {...sx(styles.metaRow, type.meta)}>
					<p>
						<FormattedDate date={pubDate.toString()} />
					</p>
					<span>·</span>
					<p>
						{readingTime} min read
					</p>
				</div>

				{
				showTldr && (
					<p {...sx(styles.measure, type.lede)}>
						<span {...sx(styles.tldrLead)}>tl;dr: </span>
						{description}
					</p>
				)
				}
				<div class='prose prose-thoughts'>
					<slot />
				</div>

				<RelatedPosts posts={relatedPosts} />
			</article>
		</div>
	</RootLayout>

	<script>
		document.querySelectorAll('#blog-content .prose :is(h2, h3, h4)[id]').forEach((heading) => {
			heading.addEventListener('click', () => {
				const url = `${window.location.origin}${window.location.pathname}#${heading.id}`;
				navigator.clipboard.writeText(url);
				history.replaceState(null, '', `#${heading.id}`);
			});
		});
	</script>

	<script>
		const vibrate = (pattern: number | number[]) => navigator.vibrate?.(pattern);

		const article = document.getElementById('blog-content');

		if (article) {
			const RATCHET_PX = 150;
			const milestones = [0.25, 0.5, 0.75, 1.0];
			const milestonePatterns: (number | number[])[] = [
				15,
				25,
				[15, 30, 25],
				[30, 50, 40],
			];
			const fired = new Set<number>();

			let lastY = window.scrollY;
			let ratchet = 0;

			window.addEventListener('scroll', () => {
				const currentY = window.scrollY;
				ratchet += Math.abs(currentY - lastY);
				lastY = currentY;

				if (ratchet >= RATCHET_PX) {
					vibrate(8);
					ratchet = ratchet % RATCHET_PX;
				}

				const articleTop = article.getBoundingClientRect().top + window.scrollY;
				const progress = Math.min(
					(currentY + window.innerHeight - articleTop) / article.offsetHeight,
					1
				);

				milestones.forEach((m, i) => {
					if (!fired.has(m) && progress >= m) {
						fired.add(m);
						vibrate(milestonePatterns[i]);
					}
				});
			}, { passive: true });
		}
	</script>
</html>
