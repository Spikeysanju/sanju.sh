---
import { sx } from "@utils/sx";
import { styles } from "./root-layout.styles";

interface Props {
	maxWidth?: "xl" | "article";
}

const { maxWidth = "xl" } = Astro.props;
---

<div
	id='root-container'
	{...sx(styles.root, maxWidth === "article" ? styles.article : styles.xl)}>
	<slot />
</div>

<script>
	import { WebHaptics } from 'web-haptics';

	// single shared instance — any page can use window.__haptics
	const haptics = new WebHaptics();
	(window as any).__haptics = haptics;

	document.addEventListener('click', (e) => {
		const target = e.target as Element;
		if (target.closest('a, button')) {
			haptics.trigger([{ duration: 15, intensity: 0.4 }]);
		}
	});
</script>
